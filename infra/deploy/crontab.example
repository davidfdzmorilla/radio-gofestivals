# radio.gofestivals · cron jobs (staging/prod)
#
# Instalación:
#   sudo mkdir -p /var/log/radio
#   sudo chown $(whoami): /var/log/radio
#   crontab -e
#   # pegar el contenido de este archivo

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Sync diario Radio-Browser a las 04:00 UTC
0 4 * * * /home/david/compose/radio-gofestivals/infra/deploy/run-job.sh rb_sync bash -c 'cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts rb_sync run' >> /var/log/radio/rb_sync.log 2>&1

# Snapshot diario de clickcount post-sync (04:15 UTC)
15 4 * * * cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts snapshot-clickcounts >> /var/log/radio/snapshot.log 2>&1

# Cálculo del 7-day click_trend post-snapshot (04:20 UTC)
20 4 * * * cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts compute-click-trends >> /var/log/radio/click_trends.log 2>&1

# Recalcular quality scores tras sync, a las 04:30 UTC
30 4 * * * cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts compute-quality-scores >> /var/log/radio/quality.log 2>&1

# Similitud emisora-emisora para recomendaciones (tras quality, 04:40 UTC)
40 4 * * * cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts compute-station-similarity >> /var/log/radio/similarity.log 2>&1

# Logos de emisoras (ADR 011): descarga y procesa los favicon que rb_sync acaba de guardar.
# Tras rb_sync y similitud (04:50 UTC); envuelto en run-job.sh para avisar si falla.
# Solo toca lo pendiente (nuevo, URL cambiada, reintento con backoff, refresco mensual).
50 4 * * * /home/david/compose/radio-gofestivals/infra/deploy/run-job.sh fetch-logos bash -c 'cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts fetch-logos' >> /var/log/radio/fetch_logos.log 2>&1

# Cleanup mensual de history (día 1 de cada mes, 04:45 UTC)
45 4 1 * * cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts cleanup-clickcount-history >> /var/log/radio/cleanup.log 2>&1

# Retención de plays: agrega a daily lo > 90d y borra el detalle (03:45 UTC, justo después del backup de Postgres)
45 3 * * * cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts retain-plays >> /var/log/radio/retain_plays.log 2>&1

# Health-check de streams cada 6 horas
0 */6 * * * cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm scripts rb_sync health-check >> /var/log/radio/health.log 2>&1

# Backup Postgres diario a las 03:00 UTC
0 3 * * * /home/david/compose/radio-gofestivals/infra/deploy/run-job.sh backup /home/david/compose/radio-gofestivals/infra/deploy/backup-postgres.sh >> /var/log/radio/backup.log 2>&1

# Rotación simple de logs propios (14 días)
0 2 * * * find /var/log/radio -name "*.log" -mtime +14 -delete

# ---------------------------------------------------------------------------
# Alerting por Telegram (ADR 006). Requiere TELEGRAM_ALERT_TOKEN y
# TELEGRAM_ALERT_CHAT_ID en .env.production. Sin ellos `watchdog` falla al arrancar.
# ---------------------------------------------------------------------------

# Watchdog cada 15 min: caída de catálogo, health-check parado, contenedores/reinicios
*/15 * * * * /home/david/compose/radio-gofestivals/infra/deploy/watchdog.sh >> /var/log/radio/watchdog.log 2>&1

# Resumen diario (07:00 UTC) · sirve también de latido: si deja de llegar, algo falla
0 7 * * * cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm -T scripts watchdog summary >> /var/log/radio/watchdog.log 2>&1

# Jobs críticos con aviso si terminan con código != 0: anteponer run-job.sh <nombre>.
# rb_sync (04:00) y backup (03:00) ya van envueltos arriba. Para comandos con
# `cd && docker compose ...` hay que envolverlos en bash -c '...' como en rb_sync.

# ---------------------------------------------------------------------------
# Clasificación "¿es electrónica?" (ADR 012). Fase 2 en modo sombra: no oculta nada.
# 05:00 reglas sobre todo el catálogo (rápido, sin red); 05:10 segundo clasificador con
# `claude -p` y la suscripción de Claude Code del usuario del cron (sin clave de API). Corre tras
# rb_sync (04:00) y fetch-logos (04:50) y lejos de las horas de trabajo para no competir por la
# cuota de la suscripción. Tarda ~2 min con 120 emisoras por ejecución.
# ---------------------------------------------------------------------------
0 5 * * * /home/david/compose/radio-gofestivals/infra/deploy/run-job.sh classify-rules bash -c 'cd /home/david/compose/radio-gofestivals && docker compose --env-file .env.production -f docker-compose.prod.yml run --rm -T scripts classify-stations run >/dev/null' >> /var/log/radio/classify.log 2>&1
10 5 * * * /home/david/compose/radio-gofestivals/infra/deploy/run-job.sh classify-llm /home/david/compose/radio-gofestivals/infra/deploy/classify-llm.sh >> /var/log/radio/classify.log 2>&1
# 05:30 aplica el veredicto a la visibilidad (ADR 012, Fase 3a): oculta las rechazadas (reversible)
# y repone las reclasificadas. Tope de 5 % del catálogo visible por ejecución: si lo supera no
# aplica nada y avisa por Telegram (para un despliegue inicial grande: ver classify-enforce.sh).
30 5 * * * /home/david/compose/radio-gofestivals/infra/deploy/run-job.sh classify-enforce /home/david/compose/radio-gofestivals/infra/deploy/classify-enforce.sh >> /var/log/radio/classify.log 2>&1
